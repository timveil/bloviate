<ruleset name="Bloviate Ruleset"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.net/ruleset_2_0_0.xsd">

    <description>
        Shared PMD ruleset for every Bloviate module. Inherits Best Practices and Error Prone,
        with exclusions scoped to patterns that are deliberate in a seeded data generator.
    </description>

    <!-- =========================================================================
         Best Practices
         ========================================================================= -->
    <rule ref="category/java/bestpractices.xml">

        <!--
            GuardLogStatement: the codebase uses SLF4J 2.x parameterized logging throughout
            (logger.debug("msg {}", var)), which already defers formatting. Excluded here and
            re-included below scoped to trace level, where an explicit guard does pay off.
        -->
        <exclude name="GuardLogStatement"/>

        <!--
            UseVarargs: converting a trailing array parameter to varargs is a
            binary-incompatible change for downstream callers of a published library.
        -->
        <exclude name="UseVarargs"/>

        <!--
            ImplicitFunctionalInterface: @FunctionalInterface is a binding compatibility promise —
            an interface carrying it can never gain a second abstract method without breaking every
            lambda that implements it. DatabaseSupport is an extension point that is expected to
            grow, and Fillable, Builder and IndexedDataGenerator are single-method today by
            coincidence rather than by contract. Annotating them to satisfy a linter would harden an
            API decision that has not been made.
        -->
        <exclude name="ImplicitFunctionalInterface"/>

    </rule>

    <!-- Re-include GuardLogStatement, scoped to trace only -->
    <rule ref="category/java/bestpractices.xml/GuardLogStatement">
        <properties>
            <property name="logLevels" value="trace"/>
            <property name="guardsMethods" value="isTraceEnabled"/>
        </properties>
    </rule>

    <!-- =========================================================================
         Error Prone
         ========================================================================= -->
    <rule ref="category/java/errorprone.xml">

        <!--
            AvoidFieldNameMatchingMethodName: fires 72 times, every one of them the fluent
            builder idiom this library's public API is built on:

                private Integer seed;
                public Builder seed(Integer seed) { this.seed = seed; return this; }

            Renaming either side would change the documented builder API. At 65% of the
            total baseline this rule alone would bury every other finding.
        -->
        <exclude name="AvoidFieldNameMatchingMethodName"/>

        <!--
            AvoidDuplicateLiterals: the SQL type-name tables in io.bloviate.ext repeat type
            keywords across the four DatabaseSupport implementations. Naming each one adds
            indirection without making the mapping tables easier to read.
        -->
        <exclude name="AvoidDuplicateLiterals"/>

        <!--
            AvoidLiteralsInIfCondition: bounds and size checks in the generators are
            intentional and self-documenting (e.g. scale == 0, length < 1). Extracting them
            to constants would obscure rather than clarify.
        -->
        <exclude name="AvoidLiteralsInIfCondition"/>

        <!--
            ReplaceJavaUtilDate / ReplaceJavaUtilCalendar: java.sql.Date, Time and Timestamp
            all extend java.util.Date, and the JDBC PreparedStatement/ResultSet signatures
            these generators must satisfy are defined in terms of them. Not changeable.
        -->
        <exclude name="ReplaceJavaUtilDate"/>
        <exclude name="ReplaceJavaUtilCalendar"/>

        <!--
            AssignmentInOperand: 11 occurrences, all standard Java read-loop and cursor idioms:
            `while ((line = reader.readLine()) != null)`, a post-decrement countdown in the random
            string builder, and `tasks.get(next++)` when topping up a bounded work pipeline.
            Splitting these into a separate assignment makes the loop longer without making it
            clearer.
        -->
        <exclude name="AssignmentInOperand"/>

        <!--
            NullAssignment: 9 occurrences, and every one is null being carried deliberately rather
            than a field being cleared. The metadata records (Table, Database, ForeignKey,
            PrimaryKey, TableConfiguration, DatabaseConfiguration) use null-preserving defensive
            copies in their compact constructors:

                columns = columns == null ? null : List.copyOf(columns);

            Collapsing null to an empty list there would erase the difference between "no foreign
            keys" and "foreign keys not yet read from the catalog". The array generators assign null
            for the same reason — see ReturnEmptyCollectionRatherThanNull below.
        -->
        <exclude name="NullAssignment"/>

        <!--
            ReturnEmptyCollectionRatherThanNull: the two sites are JDBC read paths
            (IntegerArrayGenerator, StringArrayGenerator) returning null when ResultSet.getArray
            reports SQL NULL. Returning an empty array instead would silently convert NULL into a
            zero-length array, losing a distinction the database makes and this library exists to
            reproduce faithfully. This is a correctness constraint, not a style preference.
        -->
        <exclude name="ReturnEmptyCollectionRatherThanNull"/>

    </rule>

</ruleset>
